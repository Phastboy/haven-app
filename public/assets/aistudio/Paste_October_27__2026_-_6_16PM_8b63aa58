<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Haven Native Android Child Screens: Edit Profile, Email Auth & Error States</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: #F3F4F6;
    color: #111827;
    padding: 40px 24px;
    -webkit-font-smoothing: antialiased;
  }

  .spec-header {
    max-width: 1400px;
    margin: 0 auto 36px auto;
  }

  .spec-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #111827;
    color: #FFFFFF;
    padding: 4px 10px;
    border-radius: 4px;
    margin-bottom: 12px;
  }

  .spec-title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #111827;
    margin-bottom: 8px;
  }

  .spec-desc {
    font-size: 14px;
    line-height: 1.5;
    color: #4B5563;
    max-width: 900px;
  }

  .section-container {
    max-width: 1400px;
    margin: 0 auto 52px auto;
  }

  .section-heading-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid #E5E7EB;
    padding-bottom: 12px;
    margin-bottom: 24px;
  }

  .section-heading {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section-tag {
    font-size: 13px;
    font-weight: 500;
    color: #6B7280;
  }

  .frame-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    align-items: flex-start;
  }

  .frame-wrapper {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .frame-caption {
    font-size: 12px;
    font-weight: 600;
    color: #4B5563;
    display: flex;
    justify-content: space-between;
  }

  .frame-caption .route {
    font-family: monospace;
    color: #6B7280;
    font-weight: normal;
  }

  /* 390 x 844 Native Device Shell */
  .mobile-shell {
    width: 390px;
    height: 844px;
    background-color: #FFFFFF;
    border-radius: 36px;
    box-shadow: 0 16px 40px -12px rgba(0,0,0,0.12), 0 0 0 1px rgba(0,0,0,0.06);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Status Bar */
  .status-bar {
    height: 24px;
    padding: 0 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    font-weight: 600;
    color: #111827;
    user-select: none;
    background: transparent;
    z-index: 10;
  }

  .status-icons {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Back-only App Bar */
  .top-app-bar {
    height: 48px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    background: #FFFFFF;
    z-index: 10;
  }

  .icon-btn-back {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 24px;
  }

  /* Gesture Nav Inset */
  .gesture-inset {
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    z-index: 20;
    flex-shrink: 0;
  }

  .gesture-pill {
    width: 72px;
    height: 4px;
    background-color: #111827;
    border-radius: 2px;
  }

  /* Scrollable Content Area */
  .screen-scroll-body {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: 0 16px 20px 16px;
  }

  /* Titles */
  .content-title {
    font-size: 25px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #111827;
    margin-bottom: 6px;
  }

  .content-subtitle {
    font-size: 16px;
    line-height: 1.45;
    color: #6B7280;
    margin-bottom: 24px;
  }

  /* Form Elements */
  .field-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 18px;
  }

  .field-label {
    font-size: 14px;
    font-weight: 500;
    color: #111827;
    margin-bottom: 6px;
  }

  .input-text {
    width: 100%;
    height: 48px;
    padding: 0 14px;
    font-size: 15px;
    font-family: inherit;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    background: #FFFFFF;
    color: #111827;
    outline: none;
  }

  .input-text:focus {
    border-color: #111827;
  }

  .input-error {
    border-color: #111827 !important;
  }

  .input-prefix-wrapper {
    display: flex;
    align-items: center;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    height: 48px;
    background: #FFFFFF;
    overflow: hidden;
  }

  .input-prefix-wrapper.error {
    border-color: #111827;
  }

  .input-prefix {
    padding-left: 14px;
    font-size: 15px;
    color: #6B7280;
    font-weight: 500;
    user-select: none;
  }

  .input-prefixed {
    border: none;
    height: 100%;
    flex: 1;
    padding: 0 14px 0 4px;
    font-size: 15px;
    font-family: inherit;
    color: #111827;
    outline: none;
  }

  .textarea-field {
    width: 100%;
    min-height: 110px;
    padding: 12px 14px;
    font-size: 15px;
    line-height: 1.5;
    font-family: inherit;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    background: #FFFFFF;
    color: #111827;
    resize: none;
    outline: none;
  }

  .field-help {
    font-size: 13px;
    color: #6B7280;
    margin-top: 5px;
    line-height: 1.4;
  }

  .field-error-text {
    font-size: 13px;
    font-weight: 500;
    color: #111827;
    margin-top: 5px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  /* Avatar Section in Edit Profile */
  .avatar-edit-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 24px;
  }

  .avatar-img-96 {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    background: #E5E7EB;
  }

  .avatar-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 12px;
  }

  .btn-text {
    font-size: 14px;
    font-weight: 600;
    color: #111827;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 4px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .avatar-help-text {
    font-size: 13px;
    color: #6B7280;
    margin-top: 8px;
    max-width: 280px;
    line-height: 1.4;
  }

  /* Buttons */
  .btn-primary-52 {
    width: 100%;
    height: 52px;
    background: #111827;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin-top: 8px;
    transition: opacity 0.15s;
  }

  .btn-outline-52 {
    width: 100%;
    height: 52px;
    background: #FFFFFF;
    color: #111827;
    font-size: 16px;
    font-weight: 600;
    border-radius: 8px;
    border: 1px solid #D1D5DB;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s;
  }

  .btn-primary-48 {
    width: 100%;
    height: 48px;
    background: #111827;
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  /* Snackbar Toast */
  .snackbar-toast {
    position: absolute;
    bottom: 40px;
    left: 16px;
    right: 16px;
    background: #111827;
    color: #FFFFFF;
    border-radius: 8px;
    padding: 14px 16px;
    font-size: 14px;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 8px 24px rgba(0,0,0,0.18);
    z-index: 50;
  }

  /* Empty / Message Layout */
  .centered-message-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0 24px;
  }

  .icon-circle-48 {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: #F3F4F6;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    color: #111827;
  }

  .message-status-code {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #6B7280;
    margin-bottom: 6px;
  }

  .message-title {
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #111827;
    margin-bottom: 10px;
  }

  .message-desc {
    font-size: 16px;
    line-height: 1.5;
    color: #6B7280;
    margin-bottom: 32px;
  }

  /* Bottom Navigation Bar (80px) */
  .bottom-nav-bar {
    height: 80px;
    border-top: 1px solid #E5E7EB;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 0 12px;
    z-index: 20;
    flex-shrink: 0;
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-decoration: none;
    color: #6B7280;
    font-size: 12px;
    font-weight: 500;
    min-width: 68px;
    padding: 8px 0;
    position: relative;
  }

  .nav-item.active {
    color: #111827;
    font-weight: 600;
  }

  .nav-icon-container {
    width: 44px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
  }

  .nav-item.active .nav-icon-container {
    background: #F3F4F6;
  }

  .unread-dot-badge {
    position: absolute;
    top: 6px;
    right: 18px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #111827;
  }
</style>
</head>
<body>

  <header class="spec-header">
    <div class="spec-badge">Haven Native Android Specifications · Child & Error Screens (390×844)</div>
    <h1 class="spec-title">Child Screen Architecture: Edit Profile, Email Auth & Error States</h1>
    <p class="spec-desc">
      Adheres strictly to the Haven monastic design system: 24px native status bar, back-only child top app bar, 25px semibold headers, complete 1px borders, zero accent colors, 48px+ touch targets, and full-fidelity form validation / error recovery flows.
    </p>
  </header>

  <!-- SECTION 1: EDIT PROFILE -->
  <section class="section-container">
    <div class="section-heading-row">
      <h2 class="section-heading">
        1. "Edit profile" Screen <span style="font-weight: normal; font-size: 14px; color: #6B7280;">(/profile/edit)</span>
      </h2>
      <span class="section-tag">2 Frames · 390×844</span>
    </div>

    <div class="frame-grid">
      <!-- Frame 01: Edit Profile Default State with Avatar & Snackbar preview -->
      <div class="frame-wrapper">
        <div class="frame-caption">
          <span>Frame 01 · Filled Form with Photo & Avatar Toast</span>
          <span class="route">State: Saved & Active</span>
        </div>
        <div class="mobile-shell">
          <!-- Android Status Bar -->
          <div class="status-bar">
            <span>9:41</span>
            <div class="status-icons">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C7.5 3 3.7 4.9 1 8l11 13L23 8c-2.7-3.1-6.5-5-11-5z"/></svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M2 22h20V2L2 22z"/></svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17 4h-3V2h-4v2H7v18h10V4z"/></svg>
            </div>
          </div>

          <!-- Back-only Top Bar -->
          <div class="top-app-bar">
            <button class="icon-btn-back" aria-label="Go back">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
          </div>

          <!-- Body -->
          <div class="screen-scroll-body">
            <h1 class="content-title">Edit profile</h1>
            <p class="content-subtitle">Update your public name, handle, bio, and avatar.</p>

            <!-- Centred 96px Avatar -->
            <div class="avatar-edit-box">
              <img src="https://lh3.googleusercontent.com/aida/AEtjO1XT1RMubL8e8hGOBhw0NvVZyAtLhFXR1IlcXKlP77a0ZvKEXNjhZYJWYiQGy_NxHAEs-n9GJhFMoevM7g5HjrJWBU4NxEXmz-YJXxy_k9A9-crh3u1LNXdTOLbxoETTKILuDGSJC5ZCM01HqG-2e71Ilkdm7DFBWuO6ljlIEjq7PSEAW7L-ddjXkY-fO0VH3GqF89oc8Cu0CWZISQZu8NwYUFWgcU_RSDU4cM2x6Oju8m0IrHNemURl_yzw" alt="Adaeze Obi portrait" class="avatar-img-96">
              <div class="avatar-actions">
                <button class="btn-text">Change photo</button>
                <button class="btn-text">Remove photo</button>
              </div>
              <p class="avatar-help-text">JPEG, PNG or WebP up to 5 MB. Photo changes are saved right away.</p>
            </div>

            <!-- Fields -->
            <div class="field-group">
              <label class="field-label" for="name-1">Display name</label>
              <input type="text" id="name-1" class="input-text" value="Adaeze Obi">
              <span class="field-help">The name people see on your offers.</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="handle-1">Handle</label>
              <div class="input-prefix-wrapper">
                <span class="input-prefix">@</span>
                <input type="text" id="handle-1" class="input-prefixed" value="adaeze-obi">
              </div>
              <span class="field-help">Unique URL handle for your profile (e.g. alex).</span>
            </div>

            <div class="field-group">
              <label class="field-label" for="bio-1">Bio</label>
              <textarea id="bio-1" class="textarea-field">I weave Aso Oke the traditional way on a narrow loom. I take custom orders for weddings and naming ceremonies, and every piece is made to order.</textarea>
              <span class="field-help">A short bio describing what you make or offer (up to 500 characters).</span>
            </div>

            <button class="btn-primary-52">Save changes</button>
          </div>

          <!-- Snackbar Toast -->
          <div class="snackbar-toast">
            <span>Avatar photo updated successfully.</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>

          <!-- Bottom Gesture Area -->
          <div class="gesture-inset">
            <div class="gesture-pill"></div>
          </div>
        </div>
      </div>

      <!-- Frame 02: Edit Profile Field Errors State -->
      <div class="frame-wrapper">
        <div class="frame-caption">
          <span>Frame 02 · Field Error Validation States (No Accent Colors)</span>
          <span class="route">State: Validation Errors</span>
        </div>
        <div class="mobile-shell">
          <!-- Android Status Bar -->
          <div class="status-bar">
            <span>9:41</span>
            <div class="status-icons">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C7.5 3 3.7 4.9 1 8l11 13L23 8c-2.7-3.1-6.5-5-11-5z"/></svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M2 22h20V2L2 22z"/></svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17 4h-3V2h-4v2H7v18h10V4z"/></svg>
            </div>
          </div>

          <!-- Back-only Top Bar -->
          <div class="top-app-bar">
            <button class="icon-btn-back" aria-label="Go back">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
          </div>

          <!-- Body -->
          <div class="screen-scroll-body">
            <h1 class="content-title">Edit profile</h1>
            <p class="content-subtitle">Update your public name, handle, bio, and avatar.</p>

            <!-- Centred Fallback Avatar (No Photo) -->
            <div class="avatar-edit-box">
              <div style="width: 96px; height: 96px; border-radius: 50%; background: #F3F4F6; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 600; color: #111827;">
                A
              </div>
              <div class="avatar-actions">
                <button class="btn-text">Change photo</button>
              </div>
              <p class="avatar-help-text">JPEG, PNG or WebP up to 5 MB. Photo changes are saved right away.</p>
            </div>

            <!-- Fields with errors -->
            <div class="field-group">
              <label class="field-label" for="name-2">Display name</label>
              <input type="text" id="name-2" class="input-text input-error" value="A">
              <span class="field-error-text">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                Display name must be at least 2 characters.
              </span>
            </div>

            <div class="field-group">
              <label class="field-label" for="handle-2">Handle</label>
              <div class="input-prefix-wrapper error">
                <span class="input-prefix">@</span>
                <input type="text" id="handle-2" class="input-prefixed" value="Adaeze Obi!">
              </div>
              <span class="field-error-text">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                Handle must contain only lowercase letters, digits, and single hyphens.
              </span>
            </div>

            <div class="field-group">
              <label class="field-label" for="bio-2">Bio</label>
              <textarea id="bio-2" class="textarea-field input-error">Master artisan weaver with over twenty years of experience crafting ceremonial Aso Oke fabrics, heirloom textiles, and hand-loomed cloth using sustainable organic cotton and wild botanical dyes harvested from ancestral orchards. I teach communal workshops every solstice, run zero-waste fiber spinning circles, and collaborate on bespoke architectural wall hangings for public sanctuaries across West Africa. Inquiries for ceremonial robes, wedding garments, and bespoke tapestry commissions are always welcome.</textarea>
              <span class="field-error-text">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                Bio cannot exceed 500 characters.
              </span>
            </div>

            <button class="btn-primary-52">Save changes</button>
          </div>

          <!-- Bottom Gesture Area -->
          <div class="gesture-inset">
            <div class="gesture-pill"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: CHECK YOUR EMAIL & MAGIC LINK -->
  <section class="section-container">
    <div class="section-heading-row">
      <h2 class="section-heading">
        2. "Check your email" & Magic Link States <span style="font-weight: normal; font-size: 14px; color: #6B7280;">(/auth/check-email & /auth/expired)</span>
      </h2>
      <span class="section-tag">2 Frames · 390×844</span>
    </div>

    <div class="frame-grid">
      <!-- Frame 03: Check your email default -->
      <div class="frame-wrapper">
        <div class="frame-caption">
          <span>Frame 03 · Magic Link Sent (Default State)</span>
          <span class="route">/auth/check-email</span>
        </div>
        <div class="mobile-shell">
          <!-- Android Status Bar -->
          <div class="status-bar">
            <span>9:41</span>
            <div class="status-icons">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C7.5 3 3.7 4.9 1 8l11 13L23 8c-2.7-3.1-6.5-5-11-5z"/></svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M2 22h20V2L2 22z"/></svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17 4h-3V2h-4v2H7v18h10V4z"/></svg>
            </div>
          </div>

          <!-- Back-only Top Bar -->
          <div class="top-app-bar">
            <button class="icon-btn-back" aria-label="Go back">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
          </div>

          <!-- Centred Content -->
