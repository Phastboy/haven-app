<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Haven Native Mobile — Welcome & Sign-In Specification</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
<style>
  * {
    box-sizing: border-box;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .phone-frame {
    width: 390px;
    height: 844px;
    background: #FFFFFF;
    border-radius: 48px;
    box-shadow: 0 25px 60px -15px rgba(17, 24, 39, 0.12), 0 0 0 1px #E5E7EB;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }
  .status-bar {
    height: 47px;
    padding: 14px 24px 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
    color: #111827;
    z-index: 30;
    flex-shrink: 0;
  }
  .home-indicator-area {
    height: 34px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 8px;
    z-index: 30;
    flex-shrink: 0;
  }
  .home-bar {
    width: 134px;
    height: 5px;
    background-color: #111827;
    border-radius: 9999px;
  }
  .touch-target {
    min-height: 44px;
  }
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
</style>
</head>
<body class="bg-[#F3F4F6] text-[#111827] min-h-screen p-8 lg:p-12">

  <!-- Header & Specs Bar -->
  <header class="max-w-[1720px] mx-auto mb-10 pb-6 border-b border-[#E5E7EB]">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="px-2.5 py-1 text-xs font-semibold uppercase tracking-wider bg-[#111827] text-white rounded">Haven Native App</span>
          <span class="px-2.5 py-1 text-xs font-medium text-[#6B7280] bg-white border border-[#E5E7EB] rounded">iOS / Mobile 390 × 844</span>
          <span class="px-2.5 py-1 text-xs font-medium text-[#6B7280] bg-white border border-[#E5E7EB] rounded">Greyscale Monastic UI</span>
        </div>
        <h1 class="text-2xl lg:text-3xl font-bold tracking-tight text-[#111827]">Mobile Welcome & Sign-In Specifications</h1>
        <p class="text-sm text-[#6B7280] mt-1 max-w-3xl">Connected native onboarding flow honoring 47px status bar, 34px home indicator, 8px corner radii, and interactive states (keyboard open, sending, auth error, validation error).</p>
      </div>
      <div class="text-xs text-[#6B7280] bg-white px-4 py-3 rounded-xl border border-[#E5E7EB] shadow-sm space-y-1">
        <div><strong class="text-[#111827]">Viewport:</strong> 390px × 844px (Native Frame)</div>
        <div><strong class="text-[#111827]">Rules:</strong> Touch targets &ge; 44px · Greyscale palette · No browser chrome</div>
      </div>
    </div>
  </header>

  <main class="max-w-[1720px] mx-auto space-y-14">

    <!-- Section 1: Core Primary Flow (Screen 1 & Screen 2) -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <div class="w-2.5 h-2.5 rounded-full bg-[#111827]"></div>
        <h2 class="text-base font-semibold tracking-wide uppercase text-[#111827]">1. Primary Onboarding Flow (Connected Screens)</h2>
        <span class="text-xs text-[#6B7280]">Welcome (/) &rarr; Sign In (/auth/sign-in)</span>
      </div>

      <div class="flex flex-wrap items-start justify-center gap-10">

        <!-- SCREEN 1: Welcome -->
        <div class="flex flex-col items-center">
          <div class="text-xs font-semibold uppercase tracking-wider text-[#6B7280] mb-3 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Screen 1: Welcome Screen (First Launch)
          </div>
          
          <div class="phone-frame">
            <!-- Status Bar (47px) -->
            <div class="status-bar">
              <span>9:41</span>
              <div class="flex items-center gap-1.5 text-sm">
                <span class="material-symbols-outlined !text-[18px]">signal_cellular_alt</span>
                <span class="material-symbols-outlined !text-[18px]">wifi</span>
                <span class="material-symbols-outlined !text-[20px]">battery_full</span>
              </div>
            </div>

            <!-- Content Area (Screen 1) -->
            <div class="flex-1 px-6 flex flex-col justify-between overflow-hidden">
              <!-- Top Wordmark -->
              <div class="pt-4 flex-shrink-0">
                <div class="text-[20px] font-semibold tracking-tight text-[#111827]">Haven</div>
              </div>

              <!-- Photo Collage in upper half (arranged in two columns with 16px radius) -->
              <div class="my-auto pt-3 pb-1">
                <div class="grid grid-cols-2 gap-3 h-[272px]">
                  <!-- Left Column: tall single card (Fabric) -->
                  <div class="h-full rounded-[16px] overflow-hidden bg-[#F9FAFB] border border-[#E5E7EB] relative shadow-sm">
                    <img src="https://lh3.googleusercontent.com/aida/AEtjO1XPeKhs-jdQJzrx4DgSpBY5d2U7viS72LSoBderGt3o3yQ4kNfJlUSu1sF5HpcX3VkfKpj2YzZmIA9mPyU6xPv8K2Lc3NaZGOiNxwpKUw-AMr8LiAL7h98SG0f_UTJ9BgHthDunh92Q_tGYi1v6tJb4mtZz0L8tK23Fb7opxbKsfUSw_iBkPZNZHv6ecFwG9wW5PLfWzYU_Cd0JMw-g9mCIGBQkS0aM7wSs2s-J9u219OEL1ukWYWw2mvij" alt="Hand-woven ceremonial Aso Oke fabric" class="w-full h-full object-cover" />
                  </div>
                  <!-- Right Column: two stacked rounded rectangles (Brass lamp + Pottery) -->
                  <div class="h-full flex flex-col gap-3">
                    <div class="h-[148px] rounded-[16px] overflow-hidden bg-[#F9FAFB] border border-[#E5E7EB] relative shadow-sm">
                      <img src="https://lh3.googleusercontent.com/aida/AEtjO1UEVbbaU_DTh5Yxl-gsrirVw_g4SP5G75PLgLCCtSwb9iFxoc7qLTngW3g4IBr1TWy_tifez__x7vpI05ppEkiQGN45YN183UP1PYQ6MWxmthCVAMMqEWlUmM_zrdVrM8aCm9rKx5ekapZLQkaE9fMa8xHBpffoV6jyMNIh15WA_7KLzf1wzsFocyXtKqJzpzOIcAIyHXAvOaqV69hwvbvvhOCopuSD8r8yXkxRWC43n33sG9I7jlePmXCz" alt="Artisanal brass and reclaimed wood table lamp" class="w-full h-full object-cover" />
                    </div>
                    <div class="flex-1 rounded-[16px] overflow-hidden bg-[#F9FAFB] border border-[#E5E7EB] relative shadow-sm">
                      <img src="https://lh3.googleusercontent.com/aida/AEtjO1Xmqt3LsLGxkpd5OHPN9TBWizqZclRQw1J56vroPbhKpNpxyW1DrDwL6r2j3dVVsBkI-qRPjZyguHFJ8jMp_U5xzFmHPQzcWQqOcJxwnqtmdcOFIVUzxZCKILxhLEoHuXVLGMm_k6mI9AMl9l-73aliMfErKlCAxZ3ivZaRy9nijOFX9CBbr9a5dYJ6Ehw-Sw73FvyE4OacWGIceV1TySiTLFVESC63OIqNL-eWT3pM3HlHFASQyojDQU-a" alt="Handcrafted ceramic pottery cups" class="w-full h-full object-cover" />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Copy Block -->
              <div class="flex-shrink-0 pt-1 pb-4">
                <h2 class="text-[34px] font-semibold text-[#111827] leading-[1.1] tracking-tight">Exchange offers directly</h2>
                <p class="text-[16px] text-[#6B7280] leading-[1.4] mt-3">Put something you are offering on Haven, or browse what others have made available.</p>
              </div>

              <!-- Action Buttons (Bottom) -->
              <div class="flex-shrink-0 flex flex-col gap-3 pb-2">
                <button class="w-full h-[52px] bg-[#111827] text-white font-medium text-[16px] rounded-[8px] flex items-center justify-center active:bg-black transition-colors touch-target shadow-sm">
                  Browse offers
                </button>
                <button class="w-full h-[52px] bg-white border border-[#D1D5DB] text-[#111827] font-medium text-[16px] rounded-[8px] flex items-center justify-center active:bg-[#F9FAFB] transition-colors touch-target">
                  Sign in
                </button>
              </div>
            </div>

            <!-- Home Indicator Area (34px) -->
            <div class="home-indicator-area">
              <div class="home-bar"></div>
            </div>
          </div>
          <p class="text-xs text-[#6B7280] mt-3">Collage with woven fabric, brass lamp & pottery</p>
        </div>


        <!-- SCREEN 2: Sign in (Default Idle State) -->
        <div class="flex flex-col items-center">
          <div class="text-xs font-semibold uppercase tracking-wider text-[#6B7280] mb-3 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            Screen 2: Sign In (Default State)
          </div>

          <div class="phone-frame">
            <!-- Status Bar (47px) -->
            <div class="status-bar">
              <span>9:41</span>
              <div class="flex items-center gap-1.5 text-sm">
                <span class="material-symbols-outlined !text-[18px]">signal_cellular_alt</span>
                <span class="material-symbols-outlined !text-[18px]">wifi</span>
                <span class="material-symbols-outlined !text-[20px]">battery_full</span>
              </div>
            </div>

            <!-- 56px Top Bar with Back Chevron and No Title -->
            <div class="h-[56px] px-4 flex items-center flex-shrink-0 border-b border-[#E5E7EB]">
              <button class="w-10 h-10 -ml-1 rounded-full flex items-center justify-center text-[#111827] hover:bg-[#F9FAFB] active:bg-[#E5E7EB] transition-colors touch-target" aria-label="Go back">
                <span class="material-symbols-outlined !text-[26px]">chevron_left</span>
              </button>
            </div>

            <!-- Content Area (Screen 2) -->
            <div class="flex-1 px-6 pt-6 flex flex-col justify-between overflow-hidden">
              <div>
                <!-- Title & Muted Subtitle -->
                <div class="mb-7">
                  <h2 class="text-[25px] font-semibold text-[#111827] tracking-tight leading-tight">Sign in</h2>
                  <p class="text-[16px] text-[#6B7280] mt-1.5">Welcome to Haven.</p>
                </div>

                <!-- Google Auth Button (52px Outline) -->
                <button class="w-full h-[52px] bg-white border border-[#D1D5DB] text-[#111827] font-medium text-[15px] rounded-[8px] flex items-center justify-center gap-3 active:bg-[#F9FAFB] transition-colors touch-target shadow-sm">
                  <!-- Clean Monochrome Google "G" mark -->
                  <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M21.35 11.1H12v3.8h5.38c-.24 1.25-.97 2.31-2.05 3.03v2.51h3.32c1.94-1.79 3.06-4.42 3.06-7.54 0-.6-.05-1.19-.16-1.78z" fill="#111827"/>
                    <path d="M12 21c2.7 0 4.97-.9 6.63-2.45l-3.32-2.51c-.9.6-2.05.96-3.31.96-2.55 0-4.71-1.72-5.48-4.04H3.08v2.59C4.73 18.84 8.08 21 12 21z" fill="#111827"/>
                    <path d="M6.52 12.96c-.2-.6-.32-1.24-.32-1.91s.12-1.31.32-1.91V6.55H3.08A9.98 9.98 0 002 12c0 1.61.39 3.14 1.08 4.49l3.44-2.53z" fill="#111827"/>
                    <path d="M12 5.04c1.47 0 2.79.51 3.83 1.5l2.87-2.87C17.02 2.14 14.7 1.2 12 1.2 8.08 1.2 4.73 3.36 3.08 6.55l3.44 2.59c.77-2.32 2.93-4.04 5.48-4.04z" fill="#111827"/>
                  </svg>
                  <span>Sign in with Google</span>
                </button>

                <!-- Divider: 1px line with "or" in muted 13px -->
                <div class="relative my-6 flex items-center justify-center">
                  <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-[#E5E7EB]"></div>
                  </div>
                  <div class="relative px-3 bg-white text-[13px] text-[#6B7280]">or</div>
                </div>

                <!-- Email Input Form Group -->
                <div class="space-y-2">
                  <label for="email-idle" class="block text-[14px] font-medium text-[#111827]">Email</label>
                  <input 
                    id="email-idle" 
                    type="email" 
                    placeholder="name@example.com" 
                    value=""
                    class="w-full h-[52px] px-3.5 bg-white border border-[#D1D5DB] rounded-[8px] text-[15px] text-[#111827] placeholder-[#9CA3AF] focus:outline-none focus:border-[#111827] touch-target transition-colors"
                  />
                  <p class="text-[13px] text-[#6B7280]">The link works for 15 minutes.</p>
                </div>

                <!-- Primary Submit Button (52px Solid near-black) -->
                <div class="mt-5">
                  <button class="w-full h-[52px] bg-[#111827] text-white font-medium text-[16px] rounded-[8px] flex items-center justify-center active:bg-black transition-colors touch-target shadow-sm">
                    Send magic link
                  </button>
                </div>
              </div>

              <!-- Centered account creation notice -->
              <div class="pb-3 text-center">
                <p class="text-[13px] text-[#6B7280] leading-snug">
                  New to Haven? We'll create your account the first time you sign in.
                </p>
              </div>
            </div>

            <!-- Home Indicator Area (34px) -->
            <div class="home-indicator-area">
              <div class="home-bar"></div>
            </div>
          </div>
          <p class="text-xs text-[#6B7280] mt-3">Clean passwordless magic link + Google sign-in</p>
        </div>

      </div>
    </section>


    <!-- Section 2: Auxiliary States of Screen 2 (Keyboard Open, Sending, Error, Invalid Email) -->
    <section class="pt-8 border-t border-[#E5E7EB]">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-2.5 h-2.5 rounded-full bg-[#6B7280]"></div>
        <h2 class="text-base font-semibold tracking-wide uppercase text-[#111827]">2. Auxiliary Interaction States of Screen 2</h2>
        <span class="text-xs text-[#6B7280]">Keyboard interaction · Network submission · Security banner · Form validation</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8 justify-items-center">

        <!-- STATE A: Keyboard Open -->
        <div class="flex flex-col items-center">
          <div class="text-xs font-semibold uppercase tracking-wider text-[#6B7280] mb-3 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            State A: Keyboard Open
          </div>

          <div class="phone-frame">
            <!-- Status Bar -->
            <div class="status-bar">
              <span>9:41</span>
              <div class="flex items-center gap-1.5 text-sm">
                <span class="material-symbols-outlined !text-[18px]">signal_cellular_alt</span>
                <span class="material-symbols-outlined !text-[18px]">wifi</span>
                <span class="material-symbols-outlined !text-[20px]">battery_full</span>
              </div>
            </div>

            <!-- 56px Top Bar -->
            <div class="h-[52px] px-4 flex items-center flex-shrink-0 border-b border-[#E5E7EB]">
              <button class="w-9 h-9 -ml-1 rounded-full flex items-center justify-center text-[#111827]">
                <span class="material-symbols-outlined !text-[24px]">chevron_left</span>
              </button>
            </div>

            <!-- Content Area adjusted for focused keyboard -->
            <div class="flex-1 px-6 pt-3 flex flex-col justify-start overflow-hidden">
              <div class="mb-3">
                <h2 class="text-[22px] font-semibold text-[#111827] tracking-tight">Sign in</h2>
                <p class="text-[14px] text-[#6B7280] mt-0.5">Welcome to Haven.</p>
              </div>

              <!-- Compact Google Button -->
              <button class="w-full h-[46px] bg-white border border-[#D1D5DB] text-[#111827] font-medium text-[14px] rounded-[8px] flex items-center justify-center gap-2.5">
                <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M21.35 11.1H12v3.8h5.38c-.24 1.25-.97 2.31-2.05 3.03v2.51h3.32c1.94-1.79 3.06-4.42 3.06-7.54 0-.6-.05-1.19-.16-1.78z" fill="#111827"/>
                  <path d="M12 21c2.7 0 4.97-.9 6.63-2.45l-3.32-2.51c-.9.6-2.05.96-3.31.96-2.55 0-4.71-1.72-5.48-4.04H3.08v2.59C4.73 18.84 8.08 21 12 21z" fill="#111827"/>
                  <path d="M6.52 12.96c-.2-.6-.32-1.24-.32-1.91s.12-1.31.32-1.91V6.55H3.08A9.98 9.98 0 002 12c0 1.61.39 3.14 1.08 4.49l3.44-2.53z" fill="#111827"/>
                  <path d="M12 5.04c1.47 0 2.79.51 3.83 1.5l2.87-2.87C17.02 2.14 14.7 1.2 12 1.2 8.08 1.2 4.73 3.36 3.08 6.55l3.44 2.59c.77-2.32 2.93-4.04 5.48-4.04z" fill="#111827"/>
                </svg>
                <span>Sign in with Google</span>
              </button>

              <!-- Subtle Divider -->
              <div class="relative my-3 flex items-center justify-center">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-[#E5E7EB]"></div></div>
                <div class="relative px-2 bg-white text-[12px] text-[#6B7280]">or</div>
              </div>

              <!-- Focused Email Field with Cursor -->
              <div class="space-y-1">
                <label class="block text-[13px] font-medium text-[#111827]">Email</label>
                <div class="relative flex items-center">
                  <input 
                    type="email" 
                    value="adaeze@crafts.ng" 
                    class="w-full h-[48px] px-3 bg-white border-2 border-[#111827] rounded-[8px] text-[15px] text-[#111827] font-normal"
                    readonly
                  />
                  <!-- Simulated active cursor -->
                  <span class="absolute left-[146px] w-[2px] h-[20px] bg-[#111827] animate-pulse"></span>
                </div>
                <p class="text-[12px] text-[#6B7280]">The link works for 15 minutes.</p>
              </div>

              <!-- Button stays visible DIRECTLY ABOVE the virtual keyboard -->
              <div class="mt-3">
                <button class="w-full h-[48px] bg-[#111827] text-white font-medium text-[15px] rounded-[8px] flex items-center justify-center shadow-md">
                  Send magic link
                </button>
              </div>
            </div>

            <!-- Simulated Native iOS Keyboard (290px height) -->
            <div class="h-[296px] bg-[#D1D5DB] p-1.5 flex flex-col justify-between flex-shrink-0 select-none">
              <!-- Keyboard suggestions row -->
              <div class="h-[36px] bg-[#E5E7EB] rounded-md mx-1 flex items-center justify-around text-xs text-[#111827] font-medium border-b border-[#CBD5E1]">
                <span>@gmail.com</span>
                <span class="border-x border-[#9CA3AF] px-3">@haven.ng</span>
                <span>@outlook.com</span>
              </div>
              <!-- Keys Row 1 -->
              <div class="flex gap-1 justify-center px-1">
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">q</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">w</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">e</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">r</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">t</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">y</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">u</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">i</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">o</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">p</span>
              </div>
              <!-- Keys Row 2 -->
              <div class="flex gap-1 justify-center px-4">
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">a</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">s</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">d</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">f</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">g</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">h</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">j</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">k</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">l</span>
              </div>
              <!-- Keys Row 3 -->
              <div class="flex gap-1.5 justify-center px-1">
                <span class="w-10 h-10 bg-[#B0B7C3] rounded-md shadow flex items-center justify-center text-xs font-semibold">⇧</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">z</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">x</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">c</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">v</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">b</span>
                <span class="flex-1 h-10 bg-white rounded-md shadow flex items-center justify-center text-sm font-medium">n</span>
